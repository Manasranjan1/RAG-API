# ============================================================
# Async Document Intelligence — RAG API
# Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# Server
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# AI Provider
# Set to "google" (default) or "openai".
# Only the selected provider's API key needs to be set.
# ---------------------------------------------------------------------------
AI_PROVIDER=google

# Google Gemini (default provider — free-tier API)
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3-flash-preview
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (alternative provider)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# PostgreSQL — Supabase connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Document Processing
# These control how PDFs are split into chunks for embedding.
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
